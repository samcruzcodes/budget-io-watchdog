# Preset for the Phase 6 dataset (analysis/generate_dataset.sh): 300 users across all five personas, one simulated
# year as fast as the pipeline takes it. Problems are rarer than in the demo but still far more common than in real
# life (about 3% of transactions belong to one), so a year holds a few hundred incidents of each kind to learn from.
# SIM_SEED comes from the script: one seed for training and validation, a different one for the test set.
SIM_USERS=300
SIM_PERSONA_MIX=STUDENT:1,YOUNG_PROFESSIONAL:1,FAMILY:1,FREQUENT_TRAVELER:1,RETIREE:1
SIM_START_DATE=2026-01-01
SIM_DAYS_PER_MINUTE=max
SIM_DURATION_DAYS=365
SIM_ISSUES_START_AFTER_DAYS=30
SIM_PAUSE_AFTER_DAYS=0
SIM_SCENARIOS_ENABLED=false
SIM_RESUME=false

SIM_RATE_DUPLICATE_CHARGE=0.002
SIM_RATE_TRIAL_CONVERSION=0.4
SIM_RATE_PRICE_HIKE=0.03
SIM_RATE_SPENDING_SPIKE=0.008
SIM_RATE_CARD_TESTING=0.004
SIM_RATE_NEW_COUNTRY=0.004
SIM_RATE_DOUBLE_COFFEE=0.012
SIM_RATE_APP_STORE_PURCHASES=0.008
SIM_RATE_BIG_PURCHASE=0.008
SIM_RATE_TRIP=0.003
SIM_RATE_TOLL_ROAD_TRIP=0.004
SIM_RATE_FOREIGN_ONLINE_ORDER=0.004
