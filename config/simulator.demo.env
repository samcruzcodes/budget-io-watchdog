# Demo preset for `docker compose up` (see Configuration in docs/DESIGN.md): 3 users, one simulated month per
# real minute, and rates turned up so planted problems show up every few seconds once the 30-day warm-up
# (about one real minute) has passed.
SIM_SEED=42
SIM_USERS=3
SIM_PERSONA_MIX=STUDENT:1,FAMILY:1,FREQUENT_TRAVELER:1
SIM_START_DATE=2026-01-01
SIM_DAYS_PER_MINUTE=30
SIM_DURATION_DAYS=0
SIM_ISSUES_START_AFTER_DAYS=30

# Rates are probabilities. Unit: per card purchase (duplicate), share of free trials (trial conversion),
# per renewal (price hike), per morning coffee (double coffee), otherwise per user per simulated day.
SIM_RATE_DUPLICATE_CHARGE=0.01
SIM_RATE_TRIAL_CONVERSION=0.5
SIM_RATE_PRICE_HIKE=0.1
SIM_RATE_SPENDING_SPIKE=0.02
SIM_RATE_CARD_TESTING=0.02
SIM_RATE_NEW_COUNTRY=0.02
SIM_RATE_DOUBLE_COFFEE=0.05
SIM_RATE_APP_STORE_PURCHASES=0.02
SIM_RATE_BIG_PURCHASE=0.02
SIM_RATE_TRIP=0.01
SIM_RATE_TOLL_ROAD_TRIP=0.02
SIM_RATE_FOREIGN_ONLINE_ORDER=0.01
